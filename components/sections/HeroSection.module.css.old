/* Hero Section - Enhanced with Dynamic Particles */

.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  background: 
    radial-gradient(ellipse at top, rgba(102, 126, 234, 0.15) 0%, transparent 50%),
    radial-gradient(ellipse at bottom, rgba(240, 147, 251, 0.15) 0%, transparent 50%),
    var(--color-bg-primary);
  padding: 120px 2rem 80px;
}

/* Enhanced Animated Gradient Background */
.gradientOverlay {
  position: absolute;
  top: -50%;
  left: -50%;
  right: -50%;
  bottom: -50%;
  background: 
    linear-gradient(135deg, 
      rgba(102, 126, 234, 0.25) 0%, 
      rgba(118, 75, 162, 0.25) 25%,
      rgba(240, 147, 251, 0.25) 50%,
      rgba(245, 87, 108, 0.25) 75%,
      rgba(102, 126, 234, 0.25) 100%
    );
  background-size: 400% 400%;
  animation: gradientFlowMega 20s ease-in-out infinite;
  z-index: 0;
  filter: blur(60px);
}

@keyframes gradientFlowMega {
  0%, 100% { 
    background-position: 0% 50%; 
    transform: rotate(0deg) scale(1);
  }
  33% { 
    background-position: 50% 100%; 
    transform: rotate(120deg) scale(1.1);
  }
  66% { 
    background-position: 100% 0%; 
    transform: rotate(240deg) scale(0.95);
  }
}

/* Enhanced Floating Particles with Multiple Layers */
.hero::before,
.hero::after {
  content: '';
  position: absolute;
  width: 800px;
  height: 800px;
  border-radius: 50%;
  filter: blur(100px);
  opacity: 0.4;
  animation: floatComplex 25s ease-in-out infinite;
  pointer-events: none;
}

.hero::before {
  top: -300px;
  left: -300px;
  background: radial-gradient(
    circle, 
    rgba(102, 126, 234, 0.6) 0%, 
    rgba(118, 75, 162, 0.4) 40%,
    transparent 70%
  );
  animation-delay: -12s;
}

.hero::after {
  bottom: -300px;
  right: -300px;
  background: radial-gradient(
    circle, 
    rgba(240, 147, 251, 0.6) 0%, 
    rgba(245, 87, 108, 0.4) 40%,
    transparent 70%
  );
  animation-delay: 0s;
}

@keyframes floatComplex {
  0%, 100% { 
    transform: translate(0, 0) rotate(0deg) scale(1); 
    opacity: 0.4;
  }
  25% { 
    transform: translate(50px, -60px) rotate(90deg) scale(1.15); 
    opacity: 0.5;
  }
  50% { 
    transform: translate(-40px, -40px) rotate(180deg) scale(0.9); 
    opacity: 0.35;
  }
  75% { 
    transform: translate(-60px, 50px) rotate(270deg) scale(1.05); 
    opacity: 0.45;
  }
}

/* Animated Geometric Shapes */
.decorator {
  position: absolute;
  pointer-events: none;
  opacity: 0.15;
  animation: decoratorFloat 15s ease-in-out infinite;
}

.decorator:nth-child(1) {
  top: 10%;
  left: 5%;
  width: 150px;
  height: 150px;
  border: 3px solid var(--color-primary);
  border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
  animation-delay: -5s;
}

.decorator:nth-child(2) {
  top: 60%;
  right: 10%;
  width: 120px;
  height: 120px;
  border: 3px solid var(--color-secondary);
  border-radius: 70% 30% 30% 70% / 70% 70% 30% 30%;
  animation-delay: -10s;
}

@keyframes decoratorFloat {
  0%, 100% {
    transform: translate(0, 0) rotate(0deg);
  }
  50% {
    transform: translate(30px, -30px) rotate(180deg);
  }
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

.content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

/* Avatar Container with Enhanced 3D Effect */
.avatarContainer {
  position: relative;
  margin-bottom: 3rem;
  animation: fadeInBounce 1.2s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards;
  opacity: 0;
  transform-style: preserve-3d;
  perspective: 1000px;
}

@keyframes fadeInScale {
  from {
    opacity: 0;
    transform: scale(0.8) translateY(30px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

@keyframes fadeInBounce {
  0% {
    opacity: 0;
    transform: scale(0.5) translateY(100px) rotateX(-30deg);
  }
  60% {
    opacity: 1;
    transform: scale(1.05) translateY(-10px) rotateX(5deg);
  }
  100% {
    opacity: 1;
    transform: scale(1) translateY(0) rotateX(0deg);
  }
}

.avatar {
  width: 220px;
  height: 220px;
  border-radius: 50%;
  overflow: hidden;
  position: relative;
  border: 5px solid transparent;
  background: var(--gradient-primary);
  padding: 5px;
  box-shadow: 
    0 25px 80px rgba(0, 0, 0, 0.5),
    0 0 100px rgba(102, 126, 234, 0.6),
    0 0 150px rgba(240, 147, 251, 0.4),
    inset 0 0 30px rgba(255, 255, 255, 0.15);
  animation: avatarFloatEnhanced 8s ease-in-out infinite, avatarRotate 25s linear infinite;
  transition: transform 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

@keyframes avatarFloatEnhanced {
  0%, 100% { 
    transform: translateY(0px) scale(1); 
  }
  25% { 
    transform: translateY(-15px) scale(1.02); 
  }
  50% { 
    transform: translateY(-25px) scale(1); 
  }
  75% { 
    transform: translateY(-15px) scale(0.98); 
  }
}

@keyframes avatarFloat {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-20px); }
}

@keyframes avatarRotate {
  from { filter: hue-rotate(0deg); }
  to { filter: hue-rotate(360deg); }
}

.avatar:hover {
  transform: scale(1.05) rotate(5deg);
}

.avatarBorder {
  position: absolute;
  top: -8px;
  left: -8px;
  right: -8px;
  bottom: -8px;
  border-radius: 50%;
  background: var(--gradient-primary);
  opacity: 0.3;
  filter: blur(20px);
  animation: pulse 3s ease-in-out infinite;
  z-index: -1;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.3;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.6;
  }
}

.avatar::after {
  opacity: 1;
}

/* Content */
.content {
  color: white;
  max-width: 800px;
}

/* Title with Stagger Animation */
.title {
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 900;
  margin-bottom: 1.5rem;
  line-height: 1.1;
  letter-spacing: -0.03em;
  animation: fadeInUp 0.8s cubic-bezier(0.19, 1, 0.22, 1) 0.3s forwards;
  opacity: 0;
  color: var(--color-text-primary);
}

.highlight {
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  position: relative;
  display: inline-block;
  animation: textGlow 3s ease-in-out infinite;
}

@keyframes textGlow {
  0%, 100% {
    filter: drop-shadow(0 0 20px rgba(102, 126, 234, 0.6));
  }
  50% {
    filter: drop-shadow(0 0 40px rgba(102, 126, 234, 0.9));
  }
}

/* Subtitle with Typing Effect */
.subtitle {
  font-size: clamp(1.25rem, 3vw, 1.75rem);
  font-weight: 600;
  margin-bottom: 2rem;
  color: var(--color-text-secondary);
  min-height: 60px;
  animation: fadeInUp 0.8s cubic-bezier(0.19, 1, 0.22, 1) 0.5s forwards;
  opacity: 0;
  font-family: var(--font-family-mono);
}

/* Typing Cursor Animation */
.typingCursor {
  display: inline-block;
  width: 3px;
  height: 1.2em;
  background: var(--gradient-primary);
  margin-left: 6px;
  animation: blink 1s step-end infinite;
  vertical-align: middle;
  box-shadow: 0 0 10px currentColor;
}

@keyframes blink {
  0%, 49% { opacity: 1; }
  50%, 100% { opacity: 0; }
}

/* Description */
.description {
  font-size: clamp(1rem, 2vw, 1.25rem);
  line-height: 1.8;
  margin-bottom: 3rem;
  color: var(--color-text-tertiary);
  max-width: 700px;
  animation: fadeInUp 0.8s cubic-bezier(0.19, 1, 0.22, 1) 0.7s forwards;
  opacity: 0;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* CTA Buttons with Ripple Effect */
.cta {
  display: flex;
  gap: 1.5rem;
  justify-content: center;
  flex-wrap: wrap;
  animation: fadeInUp 0.8s cubic-bezier(0.19, 1, 0.22, 1) 0.9s forwards;
  opacity: 0;
}

.ctaButton {
  padding: 1rem 2.5rem;
  font-size: 1.125rem;
  font-weight: 600;
  border-radius: var(--radius-lg, 12px);
  text-decoration: none;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  cursor: pointer;
  border: none;
  font-family: inherit;
}

.ctaButton.primary {
  background: white;
  color: var(--color-primary, #4f46e5);
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
}

.ctaButton.primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
  background: #f9fafb;
}

.ctaButton.secondary {
  background: transparent;
  color: white;
  border: 2px solid rgba(255, 255, 255, 0.5);
}

.ctaButton.secondary:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: white;
  transform: translateY(-2px);
}

.ctaButton:active {
  transform: translateY(0);
}

/* Social Links */
.socialLinks {
  margin-top: 3rem;
  display: flex;
  gap: 1.5rem;
  justify-content: center;
  animation: fadeInUp 0.6s ease 1s forwards;
  opacity: 0;
}

.socialLink {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  -webkit-backdrop-filter: blur(10px);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  text-decoration: none;
  font-size: 1.25rem;
  transition: all 0.3s ease;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.socialLink:hover {
  background: white;
  color: var(--color-primary, #4f46e5);
  transform: translateY(-4px);
  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
}

/* Scroll Indicator */
.scrollIndicator {
  position: absolute;
  bottom: 40px;
  left: 50%;
  transform: translateX(-50%);
  animation: bounce 2s infinite;
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% { transform: translateX(-50%) translateY(0); }
  40% { transform: translateX(-50%) translateY(-10px); }
  60% { transform: translateX(-50%) translateY(-5px); }
}

.scrollIndicator button {
  background: rgba(255, 255, 255, 0.2);
  border: 2px solid rgba(255, 255, 255, 0.3);
  color: white;
  width: 40px;
  height: 60px;
  border-radius: 20px;
  cursor: pointer;
  position: relative;
  padding: 0;
  transition: all 0.3s ease;
}

.scrollIndicator button:hover {
  background: rgba(255, 255, 255, 0.3);
  border-color: rgba(255, 255, 255, 0.5);
}

.scrollIndicator button::before {
  content: '';
  position: absolute;
  top: 10px;
  left: 50%;
  transform: translateX(-50%);
  width: 6px;
  height: 10px;
  border-radius: 3px;
  background: white;
  animation: scroll 2s infinite;
}

@keyframes scroll {
  0% { opacity: 1; transform: translateX(-50%) translateY(0); }
  100% { opacity: 0; transform: translateX(-50%) translateY(20px); }
}

/* Tablet Styles */
@media (max-width: 1023px) {
  .hero {
    padding: 100px 1.5rem 60px;
  }

  .avatar {
    width: 150px;
    height: 150px;
  }

  .title {
    font-size: 2.5rem;
  }

  .subtitle {
    font-size: 1.5rem;
  }

  .bio {
    font-size: 1rem;
  }

  .ctaButton {
    padding: 0.875rem 2rem;
    font-size: 1rem;
  }
}

/* Mobile Styles */
@media (max-width: 767px) {
  .hero {
    min-height: 100svh; /* Use svh for better mobile support */
    padding: 80px 1rem 60px;
  }

  .avatar {
    width: 120px;
    height: 120px;
  }

  .greeting {
    font-size: 1rem;
  }

  .title {
    font-size: 2rem;
  }

  .subtitle {
    font-size: 1.25rem;
    min-height: 40px;
  }

  .bio {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .actions {
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  .ctaButton {
    padding: 0.75rem 1.5rem;
    font-size: 0.95rem;
    width: 100%;
    justify-content: center;
  }

  .socialLinks {
    gap: 1rem;
  }

  .socialLink {
    width: 44px;
    height: 44px;
    font-size: 1.125rem;
  }

  .scrollIndicator {
    bottom: 20px;
  }
}

/* Reduced Motion */
@media (prefers-reduced-motion: reduce) {
  .hero::before,
  .avatar,
  .scrollIndicator,
  .scrollIndicator button::before {
    animation: none;
  }

  .greeting,
  .title,
  .subtitle,
  .bio,
  .actions,
  .socialLinks {
    animation: none;
    opacity: 1;
  }
}

/* High Contrast Mode */
@media (prefers-contrast: high) {
  .hero {
    background: #000;
  }

  .ctaButton {
    border-width: 3px;
  }

  .ctaButton.primary {
    border: 3px solid #fff;
  }
}
