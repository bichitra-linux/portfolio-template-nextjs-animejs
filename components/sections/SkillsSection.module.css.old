/* Skills Section - Enhanced 3D Cards & Dynamic Grid */

.skills {
  padding: 10rem 2rem;
  background: 
    radial-gradient(ellipse at top left, rgba(102, 126, 234, 0.1) 0%, transparent 50%),
    radial-gradient(ellipse at bottom right, rgba(245, 87, 108, 0.1) 0%, transparent 50%),
    var(--color-bg-secondary);
  position: relative;
  overflow: hidden;
}

/* Enhanced Animated Grid Pattern with Glow */
.skills::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image: 
    linear-gradient(rgba(102, 126, 234, 0.05) 2px, transparent 2px),
    linear-gradient(90deg, rgba(102, 126, 234, 0.05) 2px, transparent 2px),
    linear-gradient(rgba(240, 147, 251, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(240, 147, 251, 0.03) 1px, transparent 1px);
  background-size: 100px 100px, 100px 100px, 20px 20px, 20px 20px;
  animation: gridSlideComplex 30s linear infinite;
  pointer-events: none;
  opacity: 0.8;
}

@keyframes gridSlideComplex {
  from { 
    transform: translate(0, 0); 
    opacity: 0.8;
  }
  50% { 
    opacity: 1;
  }
  to { 
    transform: translate(100px, 100px); 
    opacity: 0.8;
  }
}

.container {
  max-width: 1400px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

/* Section Header */
.header {
  text-align: center;
  margin-bottom: 5rem;
}

.sectionTitle {
  font-size: clamp(2.5rem, 5vw, 3.5rem);
  font-weight: 900;
  margin-bottom: 1rem;
  background: var(--gradient-secondary);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: fadeIn 0.8s cubic-bezier(0.19, 1, 0.22, 1);
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Category Filter with Animations */
.categories {
  display: flex;
  justify-content: center;
  gap: 1rem;
  margin-bottom: 4rem;
  flex-wrap: wrap;
}

.categoryButton {
  padding: 0.875rem 2rem;
  background: rgba(102, 126, 234, 0.05);
  border: 2px solid transparent;
  border-radius: var(--radius-full);
  color: var(--color-text-secondary);
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
  transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  font-family: inherit;
  position: relative;
  overflow: hidden;
}

.categoryButton::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0);
  width: 100%;
  height: 100%;
  background: var(--gradient-primary);
  border-radius: inherit;
  transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  z-index: -1;
}

.categoryButton:hover {
  color: white;
  border-color: var(--color-primary);
  transform: translateY(-3px);
}

.categoryButton:hover::before {
  transform: translate(-50%, -50%) scale(1);
}

.categoryButtonActive {
  background: var(--gradient-primary);
  border-color: var(--color-primary);
  color: white;
  box-shadow: var(--shadow-glow);
  transform: scale(1.05);
}

.categoryButtonActive::before {
  transform: translate(-50%, -50%) scale(1);
}

.filterButton:active {
  transform: translateY(0);
}

/* Skills Grid with 3D Cards */
.skillsGrid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
  perspective: 1000px;
}

.skillCard {
  background: rgba(30, 41, 59, 0.6);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  padding: 2.5rem;
  border-radius: var(--radius-2xl);
  border: 1px solid rgba(102, 126, 234, 0.2);
  transition: all 0.6s cubic-bezier(0.19, 1, 0.22, 1);
  position: relative;
  overflow: hidden;
  transform-style: preserve-3d;
  opacity: 0;
  animation: cardReveal 0.8s cubic-bezier(0.19, 1, 0.22, 1) forwards;
}

.skillCard:nth-child(1) { animation-delay: 0.1s; }
.skillCard:nth-child(2) { animation-delay: 0.2s; }
.skillCard:nth-child(3) { animation-delay: 0.3s; }
.skillCard:nth-child(4) { animation-delay: 0.4s; }
.skillCard:nth-child(5) { animation-delay: 0.5s; }
.skillCard:nth-child(6) { animation-delay: 0.6s; }

@keyframes cardReveal {
  from {
    opacity: 0;
    transform: translateY(50px) rotateX(-15deg);
  }
  to {
    opacity: 1;
    transform: translateY(0) rotateX(0);
  }
}

.skillCard::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: var(--gradient-primary);
  opacity: 0;
  transform: rotate(45deg);
  transition: opacity 0.6s ease;
  pointer-events: none;
}

.skillCard:hover {
  border-color: var(--color-primary);
  box-shadow: 
    0 30px 90px rgba(102, 126, 234, 0.6),
    0 0 80px rgba(102, 126, 234, 0.5),
    0 0 120px rgba(240, 147, 251, 0.3),
    inset 0 0 50px rgba(102, 126, 234, 0.15);
  transform: translateY(-15px) rotateX(8deg) rotateY(6deg) scale(1.03);
}

.skillCard:hover::before {
  opacity: 0.08;
}

/* Skill Header */
.skillHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
}

.skillInfo {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex: 1;
}

.skillIcon {
  width: 48px;
  height: 48px;
  background: var(--color-primary-light, rgba(79, 70, 229, 0.1));
  border-radius: var(--radius-md, 8px);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-primary, #4f46e5);
  font-size: 1.5rem;
  flex-shrink: 0;
}

.skillName {
  font-size: 1.125rem;
  font-weight: 600;
  color: var(--color-text, #1f2937);
}

.skillLevel {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--color-primary, #4f46e5);
  flex-shrink: 0;
}

/* Progress Bar */
.progressBar {
  width: 100%;
  height: 8px;
  background: var(--color-gray-light, #f3f4f6);
  border-radius: var(--radius-full, 9999px);
  overflow: hidden;
  position: relative;
}

.progressFill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-primary, #4f46e5), var(--color-secondary, #f59e0b));
  border-radius: var(--radius-full, 9999px);
  transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.progressFill::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  right: 0;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  animation: shimmer 2s infinite;
}

@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

/* Skill Details */
.skillDetails {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid var(--color-border, #e5e7eb);
}

.skillCategory {
  display: inline-block;
  padding: 0.25rem 0.75rem;
  background: var(--color-gray-light, #f3f4f6);
  color: var(--color-text-light, #6b7280);
  border-radius: var(--radius-sm, 4px);
  font-size: 0.8125rem;
  font-weight: 500;
}

.skillDescription {
  font-size: 0.875rem;
  color: var(--color-text-light, #6b7280);
  line-height: 1.6;
  margin-top: 0.75rem;
}

/* Empty State */
.emptyState {
  text-align: center;
  padding: var(--spacing-2xl, 4rem) 0;
  color: var(--color-text-light, #6b7280);
}

.emptyState p {
  font-size: 1.125rem;
  margin-bottom: 1rem;
}

/* Tablet Styles */
@media (max-width: 1023px) {
  .skills {
    padding: var(--spacing-xl, 3rem) 1.5rem;
  }

  .title {
    font-size: 2rem;
  }

  .description {
    font-size: 1rem;
  }

  .skillsGrid {
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .skillCard {
    padding: 1.5rem;
  }
}

/* Mobile Styles */
@media (max-width: 767px) {
  .skills {
    padding: var(--spacing-xl, 3rem) 1rem;
  }

  .header {
    margin-bottom: var(--spacing-xl, 3rem);
  }

  .title {
    font-size: 1.75rem;
  }

  .description {
    font-size: 0.95rem;
  }

  .filters {
    gap: 0.5rem;
    margin-bottom: var(--spacing-lg, 2rem);
  }

  .filterButton {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }

  .skillsGrid {
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .skillCard {
    padding: 1.25rem;
  }

  .skillHeader {
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .skillInfo {
    width: 100%;
  }

  .skillLevel {
    width: 100%;
    text-align: right;
  }

  .skillIcon {
    width: 40px;
    height: 40px;
    font-size: 1.25rem;
  }

  .skillName {
    font-size: 1rem;
  }
}

/* Reduced Motion */
@media (prefers-reduced-motion: reduce) {
  .filterButton,
  .skillCard,
  .progressFill {
    transition: none;
  }

  .progressFill::after {
    animation: none;
  }

  .skillCard:hover {
    transform: none;
  }
}

/* High Contrast Mode */
@media (prefers-contrast: high) {
  .skillCard {
    border-width: 2px;
  }

  .progressBar {
    border: 1px solid currentColor;
  }

  .filterButton {
    border-width: 3px;
  }
}

/* Print Styles */
@media print {
  .skills {
    padding: 2rem 0;
  }

  .filters {
    display: none;
  }

  .skillCard {
    break-inside: avoid;
    border: 1px solid #000;
    box-shadow: none;
  }

  .skillCard:hover {
    transform: none;
  }
}
