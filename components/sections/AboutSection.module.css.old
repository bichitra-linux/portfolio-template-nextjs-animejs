/* About Section - Enhanced Morphing & Parallax */

.about {
  padding: 10rem 2rem;
  background: 
    radial-gradient(circle at 20% 80%, rgba(102, 126, 234, 0.08) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(240, 147, 251, 0.08) 0%, transparent 50%),
    var(--color-bg-primary);
  position: relative;
  overflow: hidden;
}

/* Enhanced Morphing Background Shapes */
.about::before,
.about::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  filter: blur(120px);
  opacity: 0.2;
  animation: morphComplex 25s ease-in-out infinite;
  pointer-events: none;
  mix-blend-mode: screen;
}

.about::before {
  top: -15%;
  right: -10%;
  width: 700px;
  height: 700px;
  background: 
    radial-gradient(circle, 
      rgba(240, 147, 251, 0.4) 0%, 
      rgba(245, 87, 108, 0.3) 50%,
      transparent 70%
    );
  animation-delay: -12s;
}

.about::after {
  bottom: -15%;
  left: -10%;
  width: 800px;
  height: 800px;
  background: 
    radial-gradient(circle, 
      rgba(79, 251, 164, 0.4) 0%, 
      rgba(56, 249, 215, 0.3) 50%,
      transparent 70%
    );
  animation-delay: 0s;
}

@keyframes morphComplex {
  0%, 100% {
    border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
    transform: rotate(0deg) scale(1) translate(0, 0);
  }
  20% {
    border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%;
    transform: rotate(72deg) scale(1.15) translate(20px, -20px);
  }
  40% {
    border-radius: 50% 50% 50% 50% / 50% 50% 50% 50%;
    transform: rotate(144deg) scale(0.85) translate(-20px, 20px);
  }
  60% {
    border-radius: 70% 30% 50% 50% / 30% 50% 50% 60%;
    transform: rotate(216deg) scale(1.1) translate(15px, 15px);
  }
  80% {
    border-radius: 40% 60% 60% 40% / 60% 40% 60% 40%;
    transform: rotate(288deg) scale(0.95) translate(-15px, -15px);
  }
}

.container {
  max-width: 1400px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

/* Section Header */
.header {
  text-align: center;
  margin-bottom: 5rem;
  opacity: 0;
  animation: fadeInUp 0.8s cubic-bezier(0.19, 1, 0.22, 1) 0.2s forwards;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.sectionTitle {
  font-size: clamp(2.5rem, 5vw, 3.5rem);
  font-weight: 900;
  margin-bottom: 1.5rem;
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  position: relative;
  display: inline-block;
}

.sectionTitle::after {
  content: '';
  position: absolute;
  bottom: -10px;
  left: 50%;
  transform: translateX(-50%);
  width: 80px;
  height: 4px;
  background: var(--gradient-primary);
  border-radius: var(--radius-full);
  animation: expandWidth 1s cubic-bezier(0.19, 1, 0.22, 1) 0.5s forwards;
  width: 0;
}

@keyframes expandWidth {
  to { width: 80px; }
}

/* Content Grid with Parallax */
.content {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
  margin-bottom: 5rem;
}

/* Text Content */
.textContent {
  opacity: 0;
  animation: slideInLeft 0.8s cubic-bezier(0.19, 1, 0.22, 1) 0.4s forwards;
}

@keyframes slideInLeft {
  from {
    opacity: 0;
    transform: translateX(-60px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.paragraph {
  font-size: 1.125rem;
  line-height: 1.9;
  color: var(--color-text-secondary);
  margin-bottom: 1.5rem;
  position: relative;
  padding-left: 1.5rem;
}

.paragraph::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0.5rem;
  width: 4px;
  height: calc(100% - 1rem);
  background: var(--gradient-primary);
  border-radius: var(--radius-full);
  animation: growHeight 0.6s cubic-bezier(0.19, 1, 0.22, 1) forwards;
  height: 0;
}

@keyframes growHeight {
  to { height: calc(100% - 1rem); }
}

.details {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.detailItem {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 1rem;
  color: var(--color-text, #1f2937);
}

.detailIcon {
  width: 20px;
  height: 20px;
  color: var(--color-primary, #4f46e5);
  flex-shrink: 0;
}

.detailLabel {
  font-weight: 600;
  min-width: 80px;
}

.detailValue {
  color: var(--color-text-light, #6b7280);
}

/* Stats with Spring Animation */
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  margin-top: 3rem;
  margin-top: 2rem;
  padding-top: 2rem;
  border-top: 1px solid var(--color-border, #e5e7eb);
}

.statItem {
  text-align: center;
  opacity: 0;
  animation: popIn 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards;
  background: rgba(102, 126, 234, 0.05);
  padding: 2rem 1rem;
  border-radius: var(--radius-xl);
  border: 1px solid rgba(102, 126, 234, 0.1);
  transition: all 0.4s cubic-bezier(0.19, 1, 0.22, 1);
}

.statItem:nth-child(1) { animation-delay: 0.6s; }
.statItem:nth-child(2) { animation-delay: 0.7s; }
.statItem:nth-child(3) { animation-delay: 0.8s; }

@keyframes popIn {
  from {
    opacity: 0;
    transform: scale(0.8) translateY(20px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.statItem:hover {
  background: rgba(102, 126, 234, 0.1);
  border-color: var(--color-primary);
  transform: translateY(-5px);
  box-shadow: var(--shadow-glow);
}

.statValue {
  font-size: 3rem;
  font-weight: 900;
  background: var(--gradient-primary);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: block;
  margin-bottom: 0.75rem;
  line-height: 1;
}

.statLabel {
  font-size: 0.875rem;
  color: var(--color-text-tertiary);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 600;
}

/* Image Content with Reveal Animation */
.imageContainer {
  position: relative;
  opacity: 0;
  animation: slideInRight 0.8s cubic-bezier(0.19, 1, 0.22, 1) 0.4s forwards;
}

@keyframes slideInRight {
  from {
    opacity: 0;
    transform: translateX(60px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.imageDecorator {
  position: absolute;
  top: -20px;
  right: -20px;
  width: 100%;
  height: 100%;
  background: var(--gradient-primary);
  border-radius: var(--radius-2xl);
  z-index: -1;
  opacity: 0.2;
  animation: decoratorFloat 6s ease-in-out infinite;
}

@keyframes decoratorFloat {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(-10px, -10px); }
}

.image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  border-radius: var(--radius-2xl);
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3);
  transition: transform 0.6s cubic-bezier(0.19, 1, 0.22, 1);
  border: 2px solid rgba(102, 126, 234, 0.2);
}

.image:hover {
  transform: scale(1.05) rotate(-2deg);
  box-shadow: var(--shadow-glow);
}

/* Decorative Elements */
.imageWrapper::before {
  content: '';
  position: absolute;
  top: -20px;
  right: -20px;
  width: 200px;
  height: 200px;
  background: linear-gradient(135deg, var(--color-primary, #4f46e5), var(--color-secondary, #f59e0b));
  border-radius: 50%;
  opacity: 0.1;
  z-index: -1;
}

.imageWrapper::after {
  content: '';
  position: absolute;
  bottom: -30px;
  left: -30px;
  width: 150px;
  height: 150px;
  background: linear-gradient(225deg, var(--color-accent, #ec4899), var(--color-primary, #4f46e5));
  border-radius: 50%;
  opacity: 0.1;
  z-index: -1;
}

/* Skills Preview */
.skillsPreview {
  margin-top: 2rem;
}

.skillsPreviewTitle {
  font-size: 1.125rem;
  font-weight: 600;
  color: var(--color-text, #1f2937);
  margin-bottom: 1rem;
}

.skillTags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.skillTag {
  padding: 0.5rem 1rem;
  background: var(--color-primary-light, rgba(79, 70, 229, 0.1));
  color: var(--color-primary, #4f46e5);
  border-radius: var(--radius-full, 9999px);
  font-size: 0.875rem;
  font-weight: 500;
  transition: all 0.3s ease;
}

.skillTag:hover {
  background: var(--color-primary, #4f46e5);
  color: white;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
}

/* CTA Button */
.ctaButton {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 1rem 2rem;
  background: var(--color-primary, #4f46e5);
  color: white;
  text-decoration: none;
  border-radius: var(--radius-lg, 12px);
  font-weight: 600;
  font-size: 1rem;
  transition: all 0.3s ease;
  margin-top: 1.5rem;
  border: none;
  cursor: pointer;
  font-family: inherit;
}

.ctaButton:hover {
  background: var(--color-primary-dark, #4338ca);
  transform: translateY(-2px);
  box-shadow: 0 8px 16px rgba(79, 70, 229, 0.3);
}

.ctaButton:active {
  transform: translateY(0);
}

/* Tablet Styles */
@media (max-width: 1023px) {
  .about {
    padding: var(--spacing-xl, 3rem) 1.5rem;
  }

  .title {
    font-size: 2rem;
  }

  .description {
    font-size: 1rem;
  }

  .content {
    gap: var(--spacing-xl, 3rem);
  }

  .bio {
    font-size: 1rem;
  }

  .stats {
    gap: 1.5rem;
  }

  .statNumber {
    font-size: 2rem;
  }
}

/* Mobile Styles */
@media (max-width: 767px) {
  .about {
    padding: var(--spacing-xl, 3rem) 1rem;
  }

  .header {
    margin-bottom: var(--spacing-xl, 3rem);
  }

  .title {
    font-size: 1.75rem;
  }

  .description {
    font-size: 0.95rem;
  }

  .content {
    grid-template-columns: 1fr;
    gap: var(--spacing-lg, 2rem);
  }

  /* Image first on mobile */
  .imageContent {
    order: -1;
  }

  .bio {
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .stats {
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
  }

  .statItem {
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-align: left;
  }

  .statNumber {
    font-size: 2rem;
    margin-bottom: 0;
  }

  .skillTags {
    gap: 0.5rem;
  }

  .skillTag {
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
  }

  .ctaButton {
    width: 100%;
    justify-content: center;
  }

  .imageWrapper::before,
  .imageWrapper::after {
    display: none;
  }
}

/* Reduced Motion */
@media (prefers-reduced-motion: reduce) {
  .imageWrapper img,
  .skillTag,
  .ctaButton {
    transition: none;
  }

  .imageWrapper:hover img {
    transform: none;
  }
}

/* High Contrast Mode */
@media (prefers-contrast: high) {
  .stats {
    border-top-width: 2px;
  }

  .skillTag {
    border: 2px solid var(--color-primary, #4f46e5);
  }

  .ctaButton {
    border: 2px solid transparent;
  }
}

/* Print Styles */
@media print {
  .about {
    padding: 2rem 0;
    background: white;
  }

  .imageWrapper {
    box-shadow: none;
  }

  .ctaButton {
    display: none;
  }
}
